rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // My Plan collections are SERVER-ONLY: the app server (Firebase Admin)
    // is the only writer to membership (doc users/{uid}/membership/current)
    // and nic_time_ledger, so a signed-in user can never grant themselves
    // Nic time. Clients may read their own. The exclusion in the generic
    // rules below is what enforces the write ban — a standalone deny rule
    // alone would NOT, because any matching allow grants access.
    // All other per-user collections (conversations, notes, progress,
    // routines, profile, projects, audits, ...), including nested docs.
    match /users/{userId}/{collectionId}/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && !(collectionId in ['membership', 'nic_time_ledger']);
    }
    match /users/{userId}/{collectionId}/{docId}/{sub=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && !(collectionId in ['membership', 'nic_time_ledger']);
    }
    // Templates (Track 1, Template Flow Build Plan): shared, versioned
    // template documents at templates/{slug}. Signed-in users may READ
    // any template; clients may NEVER write templates (writes only via
    // the server / Firebase Admin, so a member cannot publish or alter a
    // template, raise its version, or approve an update for themselves).
    // Each template doc carries a numeric `version` field; new versions
    // are a new version value, and only approved versions are served
    // (approval screen is Track 3/4, not this rule).
    match /templates/{slug} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
