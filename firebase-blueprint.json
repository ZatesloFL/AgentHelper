{
  "entities": {
    "User": {
      "title": "User",
      "description": "User consent and profile metadata",
      "type": "object",
      "properties": {
        "consentAccepted": {
          "type": "boolean",
          "description": "Whether the user accepted the current consent modal"
        },
        "consentVersion": {
          "type": "number",
          "description": "Version number of the accepted consent"
        },
        "consentAcceptedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when consent was accepted"
        }
      },
      "required": ["consentAccepted", "consentVersion"]
    },
    "SessionNote": {
      "title": "SessionNote",
      "description": "Short factual note saved for a user and product",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID"
        },
        "product": {
          "type": "string",
          "description": "Product identifier"
        },
        "text": {
          "type": "string",
          "maxLength": 500,
          "description": "Note content"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["userId", "product", "text"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Saved text-only conversation transcript and routine cards",
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "description": "Product ID for the conversation"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the conversation started"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the conversation was last updated"
        },
        "summary": {
          "type": "string",
          "maxLength": 1200,
          "description": "Optional summary of the conversation"
        },
        "messages": {
          "type": "array",
          "description": "Up to 400 text-only messages in the conversation"
        }
      },
      "required": ["product", "startedAt", "updatedAt", "messages"]
    },
    "ProgressSummary": {
      "title": "ProgressSummary",
      "description": "Structured progress summary written by the agent for a user and product",
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "description": "Product ID"
        },
        "done": {
          "type": "array",
          "description": "Completed items confirmed by the user"
        },
        "inProgress": {
          "type": "array",
          "description": "Items currently in progress"
        },
        "boundariesAndPreferences": {
          "type": "array",
          "description": "User boundaries and safety preferences"
        },
        "openQuestions": {
          "type": "array",
          "description": "Open questions remaining"
        },
        "suggestedNextStep": {
          "type": "string",
          "description": "Suggested next step for the next visit"
        },
        "summary": {
          "type": "string",
          "maxLength": 1200,
          "description": "Plain, warm summary written to the user as 'you' (<= 1,200 chars)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the progress summary was last updated"
        }
      },
      "required": ["product", "summary", "updatedAt"]
    },
    "RoutineProgress": {
      "title": "RoutineProgress",
      "description": "Per-user routine progress across conversations",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not-started", "in-progress", "done"]
        },
        "completedSteps": {
          "type": "array",
          "description": "Completed step records with step, evidence, note, at"
        },
        "activeStep": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["status", "completedSteps", "activeStep", "updatedAt"]
    },
    "ToolsProfile": {
      "title": "ToolsProfile",
      "description": "User tools and devices profile",
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tools": {
          "type": "array",
          "description": "Selected tools with id, name, category, account, sensitive"
        },
        "other": {
          "type": "string",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["devices", "tools", "other", "updatedAt"]
    },
    "ProjectContract": {
      "title": "ProjectContract",
      "description": "Saved user project task contract and autonomy ladder rung",
      "type": "object",
      "properties": {
        "contract": {
          "type": "object",
          "description": "Six contract fields: goal, do, do_not, ask_me_before, report_back, stop_if"
        },
        "rung": {
          "type": "number",
          "description": "Current autonomy ladder rung (0-3)"
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused"]
        },
        "history": {
          "type": "array",
          "description": "History of rung changes [{ rung, at }]"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["contract", "rung", "status", "history", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Root user document storing consent state"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/SessionNote" },
      "description": "Per-user session notes"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Per-user saved conversations (max 400 text-only messages)"
    },
    "/users/{userId}/progress/{product}": {
      "schema": { "$ref": "#/entities/ProgressSummary" },
      "description": "Per-user per-product progress summary"
    },
    "/users/{userId}/routines/{appId}": {
      "schema": { "$ref": "#/entities/RoutineProgress" },
      "description": "Per-user routine progress across sessions"
    },
    "/users/{userId}/profile/tools": {
      "schema": { "$ref": "#/entities/ToolsProfile" },
      "description": "Per-user tools and devices profile"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/ProjectContract" },
      "description": "Per-user saved project task contracts and autonomy ladder state"
    }
  }
}
