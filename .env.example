# Server-side Gemini API key (automatically injected in AI Studio from Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public base URL where this application is hosted.
APP_URL="MY_APP_URL"

# Single Gemini Live model powering bidirectional low-latency voice and screen-share vision.
LIVE_MODEL="gemini-3.8-live"

# Primary Gemini text model for chat, progress summaries, and report drafts.
TEXT_MODEL="gemini-3.8-flash"

# Optional fallback Gemini text model used only on 429/503 after one retry with a 1-second backoff.
TEXT_MODEL_FALLBACK=""

# Direct scheduling link for confirmed human bookings with Nic.
BOOKING_URL="https://cal.com/zateslo/grab-some-human-time-with-nic"

# Google Apps Script Web App URL that receives POST { secret, report } and appends a row to the Google Sheet.
SHEET_WEBHOOK_URL=""

# Shared secret verified by the Google Apps Script webhook before writing a row.
SHEET_WEBHOOK_SECRET=""

# Direct URL to the Google Sheet containing handoff reports (opened from /admin).
SHEET_URL=""

# Display name of the human specialist shown in the UI and system prompt.
OWNER_NAME="Nic"

# Email address of the human specialist.
OWNER_EMAIL="nic@zateslo.com"

# Primary IANA timezone of the human specialist.
OWNER_TIMEZONE="America/New_York"

# Comma-separated list of verified Google account emails allowed to access /admin.
ADMIN_EMAILS="nic@zateslo.com"
