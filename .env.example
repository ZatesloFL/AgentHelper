# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR CALM SUPPORT AGENT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AI & RUNTIME (Auto-injected in AI Studio)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY (String)
# Server-side Gemini API key used for minting ephemeral tokens and fallback text chat.
# Note: Google AI Studio automatically injects this at runtime from project secrets.
# You do NOT need to configure this manually in AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL (URL String)
# The public base URL where this app is hosted.
# In AI Studio, this is automatically injected with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 2. GEMINI MODELS
# ------------------------------------------------------------------------------
# LIVE_MODEL (String, Default: "gemini-3.8-live")
# GA model powering bidirectional low-latency audio voice and 1-FPS screen share vision.
LIVE_MODEL="gemini-3.8-live"

# LIVE_MODEL_DEEP (String, Default: "gemini-3.8-live-extended-thinking")
# Optional higher-reasoning model for in-depth governance and complex reviews.
LIVE_MODEL_DEEP="gemini-3.8-live-extended-thinking"

# TEXT_MODEL (String, Default: "gemini-3.8-flash")
# High-speed text model used for chat fallback, notes distillation, and escalation summaries.
TEXT_MODEL="gemini-3.8-flash"

# ------------------------------------------------------------------------------
# 3. CALENDAR & CAL.COM INTEGRATION
# ------------------------------------------------------------------------------
# BOOKING_URL (URL String)
# Direct scheduling link for confirmed bookings with Nic.
# The server automatically parses the Cal.com username and slug from this URL
# to query the Cal.com v2 public API for live real-time available slots.
BOOKING_URL="https://cal.com/zateslo/grab-some-human-time-with-nic"

# CAL_USERNAME (String, Optional, Default: parsed from BOOKING_URL -> "zateslo")
# The Cal.com username for slot availability queries.
CAL_USERNAME="zateslo"

# CAL_EVENT_SLUG (String, Optional, Default: parsed from BOOKING_URL -> "grab-some-human-time-with-nic")
# The Cal.com event type slug for slot availability queries.
CAL_EVENT_SLUG="grab-some-human-time-with-nic"

# CALENDAR_ICS_URL (URL String, Optional)
# Private read-only iCal feed (.ics). Kept strictly server-side for free/busy calculation fallback.
# If Cal.com API is used, this is purely optional.
CALENDAR_ICS_URL=""

# WORKING_HOURS (String, Optional, Default: "Mon-Fri 10:00-16:00")
# Working hours are configured and handled directly in Cal.com.
# This variable serves as a fallback schedule if Cal.com API is ever offline.
WORKING_HOURS="Mon-Fri 10:00-16:00"

# ------------------------------------------------------------------------------
# 4. OWNER & ESCALATION DETAILS
# ------------------------------------------------------------------------------
# OWNER_NAME (String, Default: "Nic")
# The person whom the support agent introduces and escalates complex queries to.
OWNER_NAME="Nic"

# OWNER_EMAIL (Email String, Default: "nic@zateslo.com")
# Email address of the owner.
OWNER_EMAIL="nic@zateslo.com"

# OWNER_TIMEZONE (IANA Timezone String, Default: "America/New_York")
# The owner's primary working timezone for slot conversions and display.
OWNER_TIMEZONE="America/New_York"

# ESCALATION_WEBHOOK_URL (URL String, Optional)
# Webhook URL (ClickUp, Zapier, Make, Slack) that receives a structured JSON payload
# containing the handoff dossier (user goal, what was tried, screenshots/logs, user info).
ESCALATION_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# 5. ADMIN CONSOLE SECURITY
# ------------------------------------------------------------------------------
# ADMIN_PASSCODE (String, Default: "muse2026")
# Passcode required to unlock the /admin operations panel (model health, knowledge freshness, escalations).
ADMIN_PASSCODE="muse2026"
